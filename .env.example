# Telegram bot token from @BotFather
BOT_TOKEN=000000:replace_me

# Bot username (used for referral links). No leading @.
BOT_USERNAME=wotsellerok_bot

# Comma-separated Telegram user IDs allowed to use admin panel
ADMIN_IDS=123456789

# Support contact handle (without @)
SUPPORT_CONTACT=BUMZILKA

# Path to SQLite database file
DB_PATH=data/bot.db

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=bot.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# Throttling / anti-flood
RATE_LIMIT_SECONDS=0.7
RATE_LIMIT_BURST=4

# Telegram Stars conversion rate: stars = ceil(rub * STARS_PER_RUB)
# Used only as fallback if a product has no explicit stars price set.
STARS_PER_RUB=1.0

# Referral reward percent on every successful purchase
REFERRAL_PERCENT=5

# Optional outbound proxy for Telegram API (http://user:pass@host:port or socks5://...)
# Leave empty to disable.
PROXY_URL=
