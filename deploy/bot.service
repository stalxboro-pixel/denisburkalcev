[Unit]
Description=WoT Seller Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/wot-seller-bot
EnvironmentFile=/opt/wot-seller-bot/.env
ExecStart=/opt/wot-seller-bot/.venv/bin/python -m app
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=10

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/wot-seller-bot/data /opt/wot-seller-bot/logs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
